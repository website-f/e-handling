# Copy to .env and change the secrets.
POSTGRES_PASSWORD=change-me-db
ADMIN_API_KEY=change-me-admin-key
IP_HASH_SALT=change-me-salt

# Any valid, unregistered IC gets a generated fictional voter (demo only).
DEMO_FALLBACK=true

# Candidate data (https://electiondata.my/openapi). Server-side only, never exposed to the browser.
ELECTIONDATA_API_KEY=

# Candidate photos: auto-approve Wikipedia matches and faces confirmed by 2+ sites (none | wikipedia | consensus | all).
PHOTO_AUTO_APPROVE=consensus
PHOTO_PACE_SECONDS=6

# Voter register: demo (fictional, offline) or spr (each voter confirmed on MySPR Semak; they type
# the portal's CAPTCHA). spr needs SPR_INTERNAL_TOKEN (any long random string) and a completed
# candidates phase (admin > Foto Calon > "Cari foto semua calon") before lookups open.
VOTER_SOURCE=demo
SPR_INTERNAL_TOKEN=change-me-spr-token
SPR_REQUIRE_CANDIDATE_PHASE=true
SPR_MAX_CONCURRENT_PAGES=12
# Confirmed records are stored; a repeat IC is answered from storage without the portal.
# SPR_REUSE_MAX_AGE (e.g. 720h) sends older records back to the portal; 0 = always reuse.
# SPR_VOTER_RETENTION > 0 deletes records with no survey response after that long; 0 = keep all.
SPR_REUSE_MAX_AGE=0
SPR_VOTER_RETENTION=0

API_REPLICAS=2
DB_MAX_CONNS=40
GATEWAY_PORT=8800
DB_PORT=8805
